# costguard — every supported environment variable.
# Every value is a placeholder: replace with real values or wire from a
# secret store. Environment variables take precedence over the YAML config
# file (see config.example.yaml).

# ---------------------------------------------------------------------------
# STACKIT authentication (official SDK)
# The SDK reads these itself; costguard never handles key material.
# ---------------------------------------------------------------------------
# Path to a STACKIT service account key file (JSON) used by the SDK.
STACKIT_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/stackit-sa-key.json
# Alternative: a short-lived STACKIT service account token.
#STACKIT_SERVICE_ACCOUNT_TOKEN=
# Region used for SDK endpoints when not otherwise derivable.
STACKIT_REGION=eu01

# ---------------------------------------------------------------------------
# Watch scope (required)
# ---------------------------------------------------------------------------
# organisation or folder
COSTGUARD_SCOPE=organisation
# STACKIT organisation UUID (required)
COSTGUARD_ORG_ID=00000000-0000-0000-0000-000000000000
# Comma-separated folder UUIDs (required when COSTGUARD_SCOPE=folder)
#COSTGUARD_FOLDER_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
# Comma-separated region IDs to scan (required)
COSTGUARD_REGIONS=eu01
# Projects older than this (days) are hygiene candidates (required, >= 7)
COSTGUARD_MAX_AGE_DAYS=90
# Network areas older than this (days) are hygiene candidates (required, >= 7)
COSTGUARD_SNA_MAX_AGE_DAYS=60

# ---------------------------------------------------------------------------
# Protection labels (required)
# ---------------------------------------------------------------------------
# Label that protects a resource (project, folder, SNA, volume, public IP)
COSTGUARD_SAFE_LABEL_KEY=do-not-delete
COSTGUARD_SAFE_LABEL_VALUE=true

# ---------------------------------------------------------------------------
# Output (required)
# ---------------------------------------------------------------------------
# googlechat, slack or teams (prometheus is rejected at startup)
COSTGUARD_OUTPUT=googlechat
# Webhook URL of the target chat space / channel (required for webhook outputs)
COSTGUARD_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------
# true = scan and report only, no DELETE calls (default: true)
COSTGUARD_DRY_RUN=true
# Cost anomaly threshold: percent increase of the last 7-day average over the
# preceding 7-day average that flags an anomaly (default: 20)
COSTGUARD_COST_ANOMALY_THRESHOLD_PCT=20
# Monthly price per GB used for the estimated savings of detached volumes
# (default: 0.0619, standard STACKIT block storage — verify current price)
COSTGUARD_VOLUME_COST_EUR_PER_GB=0.0619
# Monthly reservation price per idle public IP used for the estimated savings
# (default: 4.82, i.e. ~0.0066 EUR/h x 730 h — verify current price)
COSTGUARD_PUBLIC_IP_COST_EUR_PER_MONTH=4.82
# How long a newly marked deletion candidate stays in warning state before it
# becomes deletable. Must exceed the scan->delete offset (1 h) with margin,
# minimum 2h (default: 8h)
COSTGUARD_GRACE_PERIOD=8h

# ---------------------------------------------------------------------------
# Interactive buttons + callback server (optional as a group)
# ---------------------------------------------------------------------------
# Public URL of the callback server. When set, notifications include
# "Do not delete" buttons and the `costguard callback` subcommand runs the
# server on COSTGUARD_CALLBACK_PORT below.
#COSTGUARD_CALLBACK_URL=https://costguard-callback.example.stackit.onrender.com
# HTTP port of the callback server (default: 8080)
COSTGUARD_CALLBACK_PORT=8080
# HMAC secret used to sign/verify button URLs. When COSTGUARD_CALLBACK_URL is
# set this is required. Supply from a secret store, never hardcode.
#COSTGUARD_CALLBACK_SECRET=
# STACKIT Secrets Manager (Vault KV v2) path of the shared whitelist,
# <mount>/<path> (e.g. secret/costguard/whitelist). Required when
# COSTGUARD_CALLBACK_URL is set.
#COSTGUARD_WHITELIST_SECRET_PATH=secret/costguard/whitelist
# Base URL of the dedicated Secrets Manager instance hosting the whitelist,
# e.g. https://secretsmanager.eu01.onstackit.cloud/<instance-id>
#COSTGUARD_SM_URL=
# Dedicated SM user for whitelist access (userpass baseline; the callback's
# credential has no reach beyond this instance — instance-level IAM is the
# boundary). Supply from a secret store, never hardcode.
#COSTGUARD_SM_USERNAME=
#COSTGUARD_SM_PASSWORD=

# ---------------------------------------------------------------------------
# Cost chart upload (optional as a group: all five or none)
# ---------------------------------------------------------------------------
#COSTGUARD_S3_ENDPOINT=https://object.storage.eu01.onstackit.cloud
#COSTGUARD_S3_REGION=eu01
#COSTGUARD_S3_ACCESS_KEY=
#COSTGUARD_S3_SECRET_KEY=
#COSTGUARD_S3_BUCKET=costguard-charts

# ---------------------------------------------------------------------------
# Whitelist (env CSV sources; merged with the YAML file and the SM entry —
# a resource listed in ANY source is protected)
# ---------------------------------------------------------------------------
#COSTGUARD_WHITELIST_PROJECTS=
#COSTGUARD_WHITELIST_FOLDERS=
#COSTGUARD_WHITELIST_VOLUMES=
#COSTGUARD_WHITELIST_PUBLIC_IPS=
# Skip volume scanning entirely for these projects (e.g. backup projects)
#COSTGUARD_WHITELIST_SKIP_VOLUME_SCAN_PROJECTS=
# Skip public IP scanning entirely for these projects
#COSTGUARD_WHITELIST_SKIP_PUBLIC_IP_SCAN_PROJECTS=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Path to a YAML config file (alternative to env vars; env wins)
#COSTGUARD_CONFIG=/etc/costguard/config.yaml
# debug, info, warn or error (default: info)
LOG_LEVEL=info
