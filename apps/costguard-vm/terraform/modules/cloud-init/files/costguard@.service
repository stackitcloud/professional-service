# Installed by costguard-vm's cloud-init (Terraform). One costguard-vm run:
# %i is the subcommand (boot, report, flag or delete). The timers start it;
# cloud-init starts costguard@boot.service once after the server is created.
[Unit]
Description=costguard-vm %i run
Documentation=https://professional-service.git.onstackit.cloud/professional-service-best-practices/professional-service/src/branch/main/apps/costguard-vm
Requires=costguard-install.service
After=costguard-install.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=costguard
Group=costguard
EnvironmentFile=/etc/costguard/costguard.env
# One run at a time: a run that starts while another one works waits for it.
ExecStart=/usr/bin/flock /run/costguard/lock /usr/local/bin/costguard-vm %i
# The lock directory survives the unit, so a waiting run keeps the same lock.
RuntimeDirectory=costguard
RuntimeDirectoryPreserve=yes
# A delete run can take a while; the waiting time for the lock counts too.
TimeoutStartSec=70min
# On stop costguard-vm gets SIGTERM and posts how far it got.
TimeoutStopSec=60s
MemoryMax=512M

# The sandbox (replaces the container of the first plan).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# cloud-init's copy of the user data holds the webhook URL.
InaccessiblePaths=-/var/lib/cloud
UMask=0077
