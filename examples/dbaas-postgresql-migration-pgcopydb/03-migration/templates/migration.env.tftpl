# Generated by 03-migration. Contains passwords, mode 0600, do not copy around.
# Read by "podman run --env-file": no quotes, everything after "=" is the value.

# Source. On the example VM the DBMS listens on 127.0.0.1 only, so no TLS.
# For a real source: its FQDN, SOURCE_SSLMODE=verify-full and SOURCE_SSLROOTCERT
# (system for a public CA, or /certs/<file>.pem mounted into the runner).
SOURCE_HOST=${source_host}
SOURCE_PORT=${source_port}
SOURCE_USER=${source_user}
SOURCE_PASSWORD=${source_password}
SOURCE_SSLMODE=disable
SOURCE_SSLROOTCERT=

# Target: PostgreSQL Flex, always TLS with full certificate check.
TARGET_HOST=${target_host}
TARGET_PORT=${target_port}
# Owner of everything on the target. pgcopydb and all steps write with it.
TARGET_USER=${target_user}
TARGET_PASSWORD=${target_password}
# Users the application connects with, comma separated. 50-post gives them
# the grants of the source role of the same name, 60-verify compares them.
APP_USERS=${app_users}
TARGET_STORAGE_GB=${target_storage_gb}
TARGET_BACKUP_SCHEDULE=${target_backup_schedule}

# Comma separated. Every step takes one of them as argument.
DATABASES=${databases}

TABLE_JOBS=${table_jobs}
INDEX_JOBS=${index_jobs}
SPLIT_TABLES_LARGER_THAN=${split_tables_larger_than}
