#!/usr/bin/env bash
# Bootstrap script generated by Terraform and executed on CP1 via SSH.
# Installs cloud-provider-stackit (CCM + CSI), ALB controller, and test workloads.
set -euo pipefail

KUBECONFIG=/etc/rancher/k3s/k3s.yaml
export KUBECONFIG

log()         { printf "[BOOTSTRAP] 🔷 %s\n" "$*"; }
log_success() { printf "[BOOTSTRAP] ✅ %s\n" "$*"; }
log_error()   { printf "[BOOTSTRAP] ❌ %s\n" "$*" >&2; exit 1; }

# --- Values injected by Terraform ---
PROJECT_ID="${project_id}"
NETWORK_ID="${network_id}"
REGION="${region}"
CP1_PUBLIC_IP="${cp1_public_ip}"
CCM_REPO_URL="${ccm_repo_url}"
CCM_BRANCH="${ccm_branch}"
ALB_CONTROLLER_IMAGE="${alb_controller_image}"
# Base64-encoded SA key (avoids quoting issues with special characters)
SA_KEY_B64="${sa_key_b64}"

# ============================================================
# 1. Wait for all 6 nodes (3 CP + 3 workers) to be Ready
# ============================================================
log "Waiting for all 6 cluster nodes to become Ready..."
READY_TIMEOUT=900
ELAPSED=0
until [ "$(kubectl get nodes --no-headers 2>/dev/null | grep -c ' Ready')" -eq 6 ]; do
  if [ $ELAPSED -ge $READY_TIMEOUT ]; then
    log_error "Timed out waiting for 6 Ready nodes after $${READY_TIMEOUT}s."
  fi
  printf "." >&2
  sleep 15
  ELAPSED=$((ELAPSED + 15))
done
echo
log_success "All 6 nodes are Ready."
kubectl get nodes -o wide

# ============================================================
# 2. Patch kubeconfig to use the public IP for external kubectl
# ============================================================
# cloud-init copied the kubeconfig with 127.0.0.1; replace with the public IP
# so users can run kubectl from their local machine.
log "Patching kubeconfig for external access..."
sed -i "s|127.0.0.1:6443|$${CP1_PUBLIC_IP}:6443|g" /home/ubuntu/.kube/config
log_success "Kubeconfig patched → https://$${CP1_PUBLIC_IP}:6443"

# ============================================================
# 3. Create cloud provider ConfigMap and Secret (CCM + CSI)
# ============================================================
log "Creating STACKIT cloud provider ConfigMap..."
kubectl apply -f - <<EOF_CM
apiVersion: v1
kind: ConfigMap
metadata:
  name: stackit-cloud-config
  namespace: kube-system
data:
  cloud.yaml: |
    global:
      projectId: $${PROJECT_ID}
      region: $${REGION}
    loadBalancer:
      networkId: $${NETWORK_ID}
EOF_CM

log "Creating STACKIT cloud provider Secret..."
kubectl apply -f - <<EOF_SECRET
apiVersion: v1
kind: Secret
metadata:
  name: stackit-cloud-secret
  namespace: kube-system
type: Opaque
data:
  sa_key.json: $${SA_KEY_B64}
EOF_SECRET
log_success "Cloud provider credentials created."

# ============================================================
# 4. Install cloud-provider-stackit (CCM + CSI driver) via kustomize
# ============================================================
log "Installing cloud-provider-stackit from $${CCM_REPO_URL} (branch: $${CCM_BRANCH})..."

# The kustomize manifests in the repo embed a stale image tag (the branch manifests are not
# always updated when a new patch release is cut). Resolve the latest semver release for this
# minor version and override the images so we always pull a real published tag.
CCM_MINOR=$(echo "$${CCM_BRANCH}" | sed 's/release-//')   # e.g. release-v1.36 -> v1.36
CCM_IMAGE_TAG=$(curl -sf "https://api.github.com/repos/stackitcloud/cloud-provider-stackit/releases?per_page=50" \
  | jq -r "[.[] | select(.tag_name | startswith(\"$${CCM_MINOR}.\"))] | sort_by(.published_at) | last | .tag_name")
if [ -z "$${CCM_IMAGE_TAG}" ] || [ "$${CCM_IMAGE_TAG}" = "null" ]; then
  log_error "Could not resolve image tag for CCM minor version $${CCM_MINOR}"
fi
log "Using CCM/CSI image tag: $${CCM_IMAGE_TAG}"

KUSTOMIZE_DIR=$(mktemp -d)
trap 'rm -rf "$${KUSTOMIZE_DIR}"' EXIT

cat > "$${KUSTOMIZE_DIR}/kustomization.yaml" <<EOF_KUST
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - $${CCM_REPO_URL}/deploy/cloud-controller-manager?ref=$${CCM_BRANCH}
  - $${CCM_REPO_URL}/deploy/csi-plugin?ref=$${CCM_BRANCH}
patches:
  - path: ccm-replicas.yaml
images:
  - name: ghcr.io/stackitcloud/cloud-provider-stackit/cloud-controller-manager
    newTag: $${CCM_IMAGE_TAG}
  - name: ghcr.io/stackitcloud/cloud-provider-stackit/stackit-csi-plugin
    newTag: $${CCM_IMAGE_TAG}
EOF_KUST

# Run CCM with 1 replica per control plane (HA leader election handles active/standby).
cat > "$${KUSTOMIZE_DIR}/ccm-replicas.yaml" <<EOF_PATCH
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stackit-cloud-controller-manager
  namespace: kube-system
spec:
  replicas: 3
EOF_PATCH

kubectl apply -k "$${KUSTOMIZE_DIR}"

log "Waiting for CCM rollout..."
kubectl rollout status deployment/stackit-cloud-controller-manager -n kube-system --timeout=300s
log "Waiting for CSI controller rollout..."
kubectl rollout status deployment/csi-stackit-controllerplugin -n kube-system --timeout=300s
log "Waiting for CSI node plugin DaemonSet..."
kubectl rollout status daemonset/csi-stackit-nodeplugin -n kube-system --timeout=300s
log_success "cloud-provider-stackit installed."

# ============================================================
# 5. Install CSI snapshot controller and CRDs
# ============================================================
log "Installing CSI snapshot CRDs..."
kubectl apply -k https://github.com/kubernetes-csi/external-snapshotter/client/config/crd
kubectl wait crd/volumesnapshots.snapshot.storage.k8s.io \
  --for=condition=established --timeout=120s
kubectl wait crd/volumesnapshotclasses.snapshot.storage.k8s.io \
  --for=condition=established --timeout=120s
kubectl wait crd/volumesnapshotcontents.snapshot.storage.k8s.io \
  --for=condition=established --timeout=120s

log "Installing CSI snapshot controller..."
kubectl apply -k https://github.com/kubernetes-csi/external-snapshotter/deploy/kubernetes/snapshot-controller
kubectl rollout status deployment/snapshot-controller -n kube-system --timeout=120s
log_success "CSI snapshot controller installed."

# ============================================================
# 6. Create ALB controller ConfigMap and Secret
# ============================================================
log "Creating ALB controller cloud config..."
kubectl apply -f - <<EOF_ALB_CM
apiVersion: v1
kind: ConfigMap
metadata:
  name: stackit-alb-config
  namespace: kube-system
data:
  cloud.yaml: |
    global:
      projectId: $${PROJECT_ID}
      region: $${REGION}
    applicationLoadBalancer:
      networkId: $${NETWORK_ID}
EOF_ALB_CM

kubectl apply -f - <<EOF_ALB_SECRET
apiVersion: v1
kind: Secret
metadata:
  name: stackit-alb-secret
  namespace: kube-system
type: Opaque
data:
  sa_key.json: $${SA_KEY_B64}
EOF_ALB_SECRET

# ============================================================
# 7. Install ALB controller (RBAC + Deployment)
# ============================================================
log "Installing STACKIT ALB controller..."
kubectl apply -f - <<EOF_ALB_RBAC
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: application-load-balancer-controller
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: application-load-balancer-controller
rules:
  - apiGroups: ["networking.k8s.io"]
    resources: ["ingressclasses"]
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["ingresses"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["ingresses/status"]
    verbs: ["get", "update", "patch"]
  - apiGroups: [""]
    resources: ["services", "secrets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["events.k8s.io"]
    resources: ["events"]
    verbs: ["create", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: application-load-balancer-controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: application-load-balancer-controller
subjects:
  - kind: ServiceAccount
    name: application-load-balancer-controller
    namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: application-load-balancer-controller-leader-election
  namespace: kube-system
rules:
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: application-load-balancer-controller-leader-election
  namespace: kube-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: application-load-balancer-controller-leader-election
subjects:
  - kind: ServiceAccount
    name: application-load-balancer-controller
    namespace: kube-system
EOF_ALB_RBAC

kubectl apply -f - <<EOF_ALB_DEPLOY
apiVersion: apps/v1
kind: Deployment
metadata:
  name: application-load-balancer-controller
  namespace: kube-system
  labels:
    app.kubernetes.io/name: application-load-balancer-controller
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: application-load-balancer-controller
  template:
    metadata:
      labels:
        app.kubernetes.io/name: application-load-balancer-controller
    spec:
      serviceAccountName: application-load-balancer-controller
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: manager
          image: $${ALB_CONTROLLER_IMAGE}
          imagePullPolicy: Always
          args:
            - --cloud-config=/etc/config/cloud.yaml
            - --leader-elect=true
            - --leader-election-namespace=kube-system
            - --health-probe-bind-address=:8081
            - --metrics-bind-address=:8080
            - --zap-log-level=info
          env:
            - name: STACKIT_SERVICE_ACCOUNT_KEY_PATH
              value: /etc/serviceaccount/sa_key.json
          ports:
            - name: metrics
              containerPort: 8080
            - name: probes
              containerPort: 8081
          livenessProbe:
            httpGet:
              path: /healthz
              port: probes
            initialDelaySeconds: 15
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /readyz
              port: probes
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: cloud-config
              mountPath: /etc/config
            - name: cloud-secret
              mountPath: /etc/serviceaccount
      volumes:
        - name: cloud-config
          configMap:
            name: stackit-alb-config
        - name: cloud-secret
          secret:
            secretName: stackit-alb-secret
EOF_ALB_DEPLOY

kubectl rollout status deployment/application-load-balancer-controller -n kube-system --timeout=120s
log_success "ALB controller installed."

# ============================================================
# 8. Apply test workloads
# ============================================================
log "Applying test workloads..."
kubectl apply -f /tmp/manifests/
log_success "Test workloads applied."

# ============================================================
# 9. Print verification commands
# ============================================================
cat <<'EOF_VERIFY'

════════════════════════════════════════════════════════════════
 Bootstrap complete — verify integrations with these commands:
════════════════════════════════════════════════════════════════

── Nodes ────────────────────────────────────────────────────────
  kubectl get nodes -o wide

── Cilium NetworkPolicy ─────────────────────────────────────────
  # Wait ~60 s for jobs to finish, then:
  kubectl get jobs -n test-cilium
  kubectl logs -n test-cilium job/allowed-client
  kubectl logs -n test-cilium job/blocked-client

── L4 Load Balancer (STACKIT NLB) ──────────────────────────────
  # Wait for EXTERNAL-IP to appear (~60–120 s):
  kubectl get svc -n test-l4-lb test-nlb-svc -o wide
  # Then test:
  # curl http://<EXTERNAL-IP>/

── L7 Load Balancer (STACKIT ALB) ──────────────────────────────
  # Wait for ADDRESS to appear (~60–120 s):
  kubectl get ingress -n test-alb hello -o wide
  # Then test:
  # curl -H "Host: test-alb.example.com" http://<ADDRESS>/

── CSI Block Storage ────────────────────────────────────────────
  kubectl get pvc -n test-csi
  kubectl get pv

── Egress debug (netshoot on every node) ────────────────────────
  kubectl get pods -n test-egress -o wide
  # Pick any pod and spawn a shell:
  # kubectl exec -n test-egress -it <pod> -- bash
  # Inside: curl -s https://ifconfig.me   dig google.com

────────────────────────────────────────────────────────────────
EOF_VERIFY
