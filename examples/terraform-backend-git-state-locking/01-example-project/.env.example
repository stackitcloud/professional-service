# STACKIT Git credentials
export GIT_USERNAME="<your-git-username>"
export GIT_PASSWORD="<your-access-token>"

# Git repo
export TF_BACKEND_GIT_GIT_REPOSITORY="https://tf-states.git.onstackit.cloud/platform-team/tf-state"
export TF_BACKEND_GIT_GIT_REF="main"
export TF_BACKEND_GIT_GIT_STATE="test/terraform.tfstate.json"

# State encryption (sops + age)
export TF_BACKEND_HTTP_ENCRYPTION_PROVIDER="sops"
# Comma separated age PUBLIC keys of everybody (people and CI) who must be able to read the state.
export TF_BACKEND_HTTP_SOPS_AGE_RECIPIENTS="age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# age PRIVATE key file, used to decrypt the state
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
