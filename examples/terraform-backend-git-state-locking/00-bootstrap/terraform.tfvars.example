stackit_parent_id = "<organization-or-folder-id>"

# Name of the bootstrapping project
stackit_project_name = "00-tf-state-bootstrap"

# Email address of the STACKIT user set as project owner.
stackit_org_admin = "<your-admin@mail.com>"

stackit_service_account_key_path = "./keys/service-account.json"

stackit_region = "eu01"

git_instance_name = "tf-states"
git_flavor        = "git-10"

# Egress IPs of workstation or CI runner IF git instance is only for tf states
git_acl = [
  "<your-egress-ip>/32",
]
