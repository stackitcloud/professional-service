# Copy this file to terraform.tfvars and fill in your values.
# stackit_region defaults to "eu01" and can be omitted.

stackit_project_id               = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
stackit_service_account_key_path = "/path/to/stackit-sa.json"

# Optional: hostnames become app.<domain> and admin.<domain>.
# domain = "example.internal"
